# Postgres: limit connections per indexer (recommended for V3)
ENVIO_PG_MAX_CONNECTIONS=10

# API Token for Envio API
ENVIO_API_TOKEN=<api-token>

# ClickHouse storage (dual-write alongside Postgres)
ENVIO_CLICKHOUSE_HOST=<clickhouse-host>
ENVIO_CLICKHOUSE_DATABASE=<clickhouse-database>
ENVIO_CLICKHOUSE_USERNAME=<clickhouse-username>
ENVIO_CLICKHOUSE_PASSWORD=<clickhouse-password>

# Canonical source prices (ADR 0009, flow F; src/Effects/CanonicalSourcePrice.ts).
# The getCanonicalSourcePrice effect reads the source chain's hourly
# TokenPriceSnapshot from the ClickHouse above. Optional overrides when the
# source chain lives in another database or on another server (credentials in
# the URL, else the ENVIO_CLICKHOUSE_USERNAME / _PASSWORD above; a read-only
# user is enough):
# PRICING_CANONICAL_CLICKHOUSE_URL=http://<user>:<password>@<host>:8123
# PRICING_CANONICAL_CLICKHOUSE_DATABASE=<clickhouse-database>
# Switch (default true): the snapshot effect.
# PRICING_CANONICAL_SNAPSHOT_EFFECT=true
# Switch (default true): when neither the seed nor the source chain's snapshots
# cover an hour, read the source's pool on its own chain over RPC (ADR 0010;
# about 10 calls per hour of a backfill's last days, cached).
# PRICING_CANONICAL_RPC_EFFECT=true

# --- RPC (see README "RPC configuration") -----------------------------------
# Primary endpoint for every chain: https://lb.drpc.live/<network>/<key>.
# The indexer refuses to start if a chain has neither this key nor its own
# ENVIO_<CHAIN>_RPC_URL.
ENVIO_DRPC_API_KEY=<drpc-api-key>

# Optional per-chain primary overrides (take precedence over the dRPC key).
# ENVIO_OPTIMISM_RPC_URL=<optimism-archive-rpc-url>
# ENVIO_BASE_RPC_URL=<base-archive-rpc-url>
# ENVIO_CELO_RPC_URL=<celo-archive-rpc-url>
# ENVIO_SONEIUM_RPC_URL=<soneium-archive-rpc-url>
# ENVIO_INK_RPC_URL=<ink-archive-rpc-url>
# ENVIO_MODE_RPC_URL=<mode-archive-rpc-url>
# ENVIO_LISK_RPC_URL=<lisk-archive-rpc-url>
# ENVIO_UNICHAIN_RPC_URL=<unichain-archive-rpc-url>
# ENVIO_FRAXTAL_RPC_URL=<fraxtal-archive-rpc-url>
# ENVIO_METAL_RPC_URL=<metal-archive-rpc-url>
# ENVIO_SUPERSEED_RPC_URL=<superseed-archive-rpc-url>
# ENVIO_SWELL_RPC_URL=<swell-archive-rpc-url>

# Optional fallback overrides (must differ from the primary; "none" disables).
# Defaults are public endpoints from src/Effects/RpcConfig.ts; Superseed has no
# working public default, so set one if you have it.
# ENVIO_SUPERSEED_FALLBACK_RPC_URL=<superseed-archive-rpc-url>
# ENVIO_BASE_FALLBACK_RPC_URL=<base-archive-rpc-url>

# Optional rate limits (requests per second, per JSON-RPC call).
# ENVIO_DRPC_MAX_RPS=80
# ENVIO_BASE_RPC_RPS=40
# ENVIO_FALLBACK_RPC_RPS=5
